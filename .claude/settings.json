{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR/.claude/hooks/cloud_session_start.sh\"",
            "timeout": 180
          }
        ]
      }
    ]
  },
  "outputStyle": "Concise",
  "extraKnownMarketplaces": {
    "i-have-adhd": {
      "source": {
        "source": "github",
        "repo": "ayghri/i-have-adhd"
      }
    }
  },
  "enabledPlugins": {
    "i-have-adhd@i-have-adhd": true
  }
}
