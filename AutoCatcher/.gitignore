# AutoCatcher -- what stays OUT of the PoGo repo (2026-09-29). Code, docs and the small HTML reports go in.

# caches and build output
__pycache__/
*.pyc
ondevice_toggle/apk/build/
*.apk
*.apk.idsig
*.class
*.dex

# SECRETS -- never commit
# the APK signing key (debug, but a private key; build.ps1 makes a new one if it is missing, and an app signed with a
# different key cannot be updated in place -- keep the original privately)
*.keystore
# raw game-settings dump: holds the game's embedded Google Maps API key (the HTML report shows it as "(hidden)")
system/analysis/game_limits.json

# backups and old builds (history lives in git now)
*.bak
*.bak.*
*.bak_*
*.bak-*
*.prepause
*.preapples
*.prelimit
*.pregraph
*.bad-*
*.crashy-*
*.prefix-*
*.v3novis
*.v3types
*.v3vis
archive/

# Gym Battle's runtime state (runner inbox, logs, studies) -- theirs; state, not code
tools/gym_state/

# logs, recordings and raw data (regenerated by the tools; some are large)
*.log
*.jsonl
system/analysis/singleton_cache.json
system/analysis/game_constants.json
system/analysis/map_full.json
system/analysis/map_density.json
system/analysis/pogo_map_data.js
system/map/manhattan_ways.json
system/map/*.pkl
system/map/*.db
system/map/routes/unspun_*
