#!/data/data/com.termux/files/usr/bin/sh
# Home-screen ON/OFF button (Termux:Widget). CONFIG-SWAP toggle: physically
# flips the gadget between script (catch) and listen (desktop) mode and
# relaunches PoGo. Put this file in ~/.shortcuts/ and add a Termux:Widget
# 1x1 widget pointing at it.
#
# NOTE: Termux:Widget is NOT installed on this device yet (per inventory).
# Install it (F-Droid) OR drive pogo-catch.sh directly from a Termux:Boot
# script / an adb shell. The script below works from any Termux shell regardless.
OUT=$(su -c '/data/local/tmp/re.zyg.fri/pogo-catch.sh toggle' 2>&1)
echo "$OUT"
# best-effort home-screen feedback (Termux:API present)
command -v termux-toast >/dev/null 2>&1 && termux-toast -g middle "$(echo "$OUT" | head -n1)"
