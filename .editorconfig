# https://editorconfig.org
# NO end_of_line for most files on purpose: .gitattributes is byte-exact (`* -text`) because two audit gates hash raw
# bytes, and many pogo_extract files are CRLF. Keep whatever ending a file already has.
root = true

[*]
charset = utf-8
insert_final_newline = true

[*.py]
indent_style = space
indent_size = 4

[*.{js,json,yml,yaml}]
indent_style = space
indent_size = 2

[*.sh]
end_of_line = lf

[*.md]
trim_trailing_whitespace = false
